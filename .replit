modules = ["nodejs-24"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["nano", "vim-full", "python311Full"]

[[ports]]
localPort = 5000
externalPort = 5000

[userenv]

[userenv.production]
EXPO_PUBLIC_API_URL = "https://memory-capture-collective.replit.app"
