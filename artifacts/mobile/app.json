{
  "expo": {
    "name": "WeRoll",
    "slug": "weroll",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "weroll",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f8f3ea"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.weroll.app"
    },
    "android": {
      "package": "com.weroll.app"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/photo-reminder.mp3"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pic Sync Collective accede alle tue foto per aggiungerle alle esperienze condivise.",
          "cameraPermission": "Pic Sync Collective usa la fotocamera per fermare i vostri momenti."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}